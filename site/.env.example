# Wake Up ☕️ — משתני סביבה לאתר (site/)
# להעתיק ל-.env.local (dev) או להגדיר בסביבת האירוח (production).
# שום מפתח אמיתי לא נמצא בקובץ הזה — placeholders בלבד.

# --- שער 2 (docs/QUALITY-GATES.md) ---
# false/לא-מוגדר = כל ה-CTA-ים מפנים לרשימת המתנה, לא לצ'קאאוט אמיתי.
# להפוך ל-true רק אחרי שסוכן 1 חתם ב-state/LOAD-TEST-LOG.md.
PUBLIC_CHECKOUT_ENABLED=false

# --- בחירת ספק תשלום ---
# mock (ברירת מחדל) | grow | cardcom | meshulam
PAYMENT_PROVIDER=mock

# --- Grow (אם PAYMENT_PROVIDER=grow) — חסום עד BLOCKERS.md #2 ---
GROW_API_KEY=
GROW_TERMINAL_ID=
GROW_WEBHOOK_SECRET=

# --- Cardcom (אם PAYMENT_PROVIDER=cardcom) — חסום עד BLOCKERS.md #2 ---
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=

# --- Meshulam (אם PAYMENT_PROVIDER=meshulam) — חסום עד BLOCKERS.md #2 ---
MESHULAM_USER_ID=
MESHULAM_API_KEY=
MESHULAM_PAGE_CODE=
