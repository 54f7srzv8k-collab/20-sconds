---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!--
      הערה לביצועים (קהל מובייל / 3G ישראלי):
      - שום JS גלובלי לא נטען כאן. אסטרו מגיש HTML סטטי טהור; JS נטען רק
        בקומפוננטות ספציפיות שבאמת צריכות אינטראקציה (client:* islands),
        כמו טופס הצ'קאאוט.
      - שום פונט חיצוני עדיין לא נטען (system font) עד שיגיע פונט המותג,
        כדי לא לחסום רינדור על רשת איטית עם @font-face לא נחוץ.
    -->
  </head>
  <body>
    <a href="#main-content" class="skip-link">דלג לתוכן הראשי</a>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
  }
  img {
    max-width: 100%;
    display: block;
  }
  a {
    color: inherit;
  }
  /*
    Skip-link (docs/ACCESSIBILITY-CHECKLIST.md §2.2, BUG-05 ב-state/BUG-LOG.md):
    מוסתר ויזואלית עד קבלת פוקוס (מקלדת), אז קופץ לפינת ההתחלה הלוגית של
    הדף (inset-inline-start מכבד RTL) כדי לאפשר דילוג ישיר ל-<main>.
  */
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-3);
    top: -100px;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-base);
    z-index: 1000;
    font-weight: 700;
    transition: top 0.15s ease-in-out;
  }
  .skip-link:focus {
    top: var(--space-3);
  }
</style>
