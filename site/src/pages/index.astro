---
/**
 * דף המכירה — placeholder תוכני/מבני, אגנוסטי לעיצוב סופי.
 *
 * זהו לא ה-copy הסופי (זה תפקיד סוכן 5 בגל 2, אחרי אישור קול ע"י סוכן 3 —
 * שער 1). זו שלד הקומפוננטות/מבנה כדי שסוכן 5 ימלא תוכן, וסוכן 3 (עיצוב,
 * כשיגיע) ימלא סטיילינג — בלי אף אחד מהם לבנות מחדש.
 *
 * שים לב ל-ctaHref(): כל עוד שער 2 לא נחתם (state/LOAD-TEST-LOG.md), הוא
 * מצביע אוטומטית ל-/waitlist ולא ל-/checkout, כנדרש ב-docs/QUALITY-GATES.md.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { PRODUCT, ctaHref } from "../config";
---

<BaseLayout
  title={`${PRODUCT.name} — קורס דיגיטלי`}
  description="קורס דיגיטלי קצר ב-6 שיעורים. גישה מיידית."
>
  <Hero
    eyebrow="קורס דיגיטלי · 6 שיעורים"
    headline={`${PRODUCT.name} — placeholder כותרת ראשית`}
    subheadline="placeholder תת-כותרת — טקסט סופי ייכתב ע״י סוכן 5 אחרי אישור קול (שער 1)."
    ctaLabel={`אני רוצה להתחיל · ${PRODUCT.priceILS} ₪`}
    ctaHref={ctaHref()}
  />

  <section class="section">
    <h2>מה מקבלים</h2>
    <ul>
      {Array.from({ length: PRODUCT.lessonsCount }).map((_, i) => (
        <li>שיעור {i + 1} — placeholder כותרת שיעור</li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>שאלות נפוצות</h2>
    <p class="muted">placeholder — ימולא ע״י סוכן 5 / סוכן 8.</p>
  </section>

  <footer class="legal-footer">
    <!--
      חובה חוקית (docs/PROJECT-BRIEF.md § התנגשות מותג אנונימי מול החוק):
      פרטי העוסק (שם עוסק, ח.פ./עוסק מורשה, דרך התקשרות) חייבים להופיע כאן.
      חסום כרגע ב-docs/BLOCKERS.md #4 — placeholder עד שהזהות המשפטית תסופק.
      סוכן 10 (ציות) אחראי על התוכן המדויק; זהו רק ה-slot במבנה הדף.
    -->
    <p class="muted small">
      פרטי העוסק (שם / ח.פ. / דרך התקשרות) — ימולאו כאן לפני יציאה לאוויר.
      ראה docs/BLOCKERS.md #4.
    </p>
  </footer>
</BaseLayout>

<style>
  .section {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .section h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
  }
  .muted {
    color: var(--color-text-muted);
  }
  .small {
    font-size: 0.85rem;
  }
  .legal-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-3);
    text-align: center;
  }
</style>
